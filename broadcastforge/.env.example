# BroadcastForge Studio configuration. Copy to .env and adjust.
# Never commit .env: it may contain your OBS password.

# HTTP/WebSocket port for the dashboard, control room and overlay URLs.
PORT=3000

# 127.0.0.1 = this computer only (default, safest).
# 0.0.0.0   = also reachable from your local network (same as --lan / npm run start:lan).
# HOST=127.0.0.1
# BF_LAN=false

# Where projects, artwork and game history are stored (relative to this folder).
# BF_DATA_DIR=data

# Extra hostnames allowed in the browser address bar (comma separated),
# e.g. a DNS name for this computer. Protects against DNS-rebinding attacks.
# BF_ALLOWED_HOSTS=studio.local

# Allow paired tablets/phones to change the OBS connection (default: host only).
# BF_REMOTE_OBS=false

# Allow overlay pages to be opened from other machines without pairing (read-only).
# Set to false if your network is untrusted and OBS runs on this computer.
# BF_PUBLIC_OVERLAY=true

# OBS WebSocket defaults (can also be set on the OBS Connection page).
# OBS_PASSWORD set here overrides the one saved in the app and is never shown in the UI.
# OBS_HOST=127.0.0.1
# OBS_PORT=4455
# OBS_PASSWORD=

# debug | info | warn | error
# LOG_LEVEL=info
